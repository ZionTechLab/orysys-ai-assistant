# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json
JWT_SECRET=change-me

# --- LLM gateway (9router, OpenAI-compatible) ---
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=
LLM_MODEL_STRONG=orysys-fast
LLM_MODEL_FAST=orysys-fast
LLM_TIMEOUT_SECONDS=20
LLM_LONG_TIMEOUT_SECONDS=120

# --- Fallback LLM called directly when the gateway is down (optional) ---
FALLBACK_LLM_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=llama-3.3-70b-versatile

# --- Pinecone ---
PINECONE_API_KEY=
PINECONE_INDEX=orysys-kb

# --- LangSmith ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=orysys-ai-assistant
LANGSMITH_TRACING=true

# --- Rate limiting (token bucket, per user) ---
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_PER_SEC=0.2
# optional per-role thresholds (JSON)
RATE_LIMIT_ROLE_OVERRIDES={"admin": {"capacity": 30, "refill_per_sec": 0.5}}
LOGIN_RATE_CAPACITY=5
LOGIN_RATE_REFILL_PER_SEC=0.0167

# --- MCP server (python -m mcp_server) ---
MCP_SERVER_URL=http://127.0.0.1:8765/mcp
# shared service key between the API and the MCP server, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEY=
MCP_HOST=127.0.0.1
MCP_PORT=8765
